#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_install:
	install -D -m 0755 target/release/retiremx debian/retiremx/usr/bin/retiremx
	install -D -m 0644 deploy/retiremx.service debian/retiremx/lib/systemd/system/retiremx.service
	install -D -m 0644 examples/retiremx.md debian/retiremx/etc/retiremx/retiremx.md

override_dh_auto_test:
	# Tests require local TCP sockets and are run separately in CI.
